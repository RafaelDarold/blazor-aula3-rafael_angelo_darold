@page "/produtos"

<h3>Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao>
            <FormProduto AoCadastrar="AdicionarProduto" />
        </Cartao>
    </div>
    <div class="col-md-8">
        <TabelaProdutos Produtos="produtos" />

        @if (produtos.Count == 0)
        {
            <p class="text-danger">Nenhum produto cadastrado</p>
        }
    </div>
</div>

@code {
    private readonly List<Produto> produtos = new();

    private void AdicionarProduto(Produto produto)
    {
        produtos.Add(produto);
    }
}
